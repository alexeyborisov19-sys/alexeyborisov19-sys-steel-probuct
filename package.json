    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.25",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.19",
