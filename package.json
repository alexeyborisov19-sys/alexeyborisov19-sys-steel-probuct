{
  "name": "steel-product-website",
  "version": "0.1.3",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "seo:audit": "node scripts/audit-seo.mjs",
    "env:check": "node --import tsx scripts/validate-production-env.ts",
    "retention:cleanup": "node scripts/cleanup-expired-leads.mjs",
    "secrets:scan": "node scripts/run-gitleaks.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "pd:migrate": "node --import tsx scripts/pd-migrate.ts",
    "pd:migrate:status": "node --import tsx scripts/pd-migrate.ts --status",
    "pd:integrity-check": "node --import tsx scripts/pd-integrity-check.ts",
    "pd:sync-index": "node --import tsx scripts/pd-sync-index.ts",
    "pd:audit-verify": "node --import tsx scripts/pd-audit-verify.ts",
    "pd:exports:expire": "node --import tsx scripts/pd-expire-exports.ts",
    "pd:stage4:demo": "node --import tsx scripts/pd-stage4-demo.ts",
    "pd:create-admin": "node --import tsx scripts/pd-create-admin.ts",
    "codex:tools:setup": "node scripts/setup-codex-tools.mjs",
    "ruflo:init": "npx -y ruflo@3.38.19 init --yes",
    "ruflo:doctor": "npx -y ruflo@3.38.19 doctor"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "next": "^15.5.22",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/mcp": "0.0.79",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.25",
    "ruflo": "3.38.19",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  }
}
