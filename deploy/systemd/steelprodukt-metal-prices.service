# Preconditions, all on the host and none of them checked automatically:
#   1. STEEL_PRODUCT_PRIVATE_CALCULATION_BASIS_PATH in .env.production. The
#      refresh writes the snapshot next to it, and the installer needs it to
#      grant this unit write access to that one directory.
#   2. pdftotext (poppler-utils) on PATH, or STEEL_PRODUCT_PDFTOTEXT_COMMAND.
#   3. The unit installed and enabled: systemctl enable --now steelprodukt-metal-prices.timer
# Verify once with:  npm run prices:refresh -- --dry-run
# Watch for silent failure with:  systemctl --failed | grep steelprodukt-metal-prices

[Unit]
Description=Steelprodukt supplier metal price refresh (Atlantik, Smolensk)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nodejs
Group=nodejs
UMask=0077
WorkingDirectory=/var/www/html
EnvironmentFile=/var/www/html/.env.production
# Calls the refresh directly rather than posting to the app's own loopback
# endpoint: that removed a shared secret whose only job was letting the server
# authenticate to itself, and the refresh no longer depends on the site being up.
# The react-server condition resolves the server-only guards outside Next.js.
# Invoked directly rather than through npm: ProtectHome=true hides the home
# directory, and npm wants a cache there. The script is plain ESM.
ExecStart=/usr/bin/node --conditions react-server --import tsx --import /var/www/html/scripts/repo-alias-hook.mjs /var/www/html/scripts/refresh-steel-product-prices.ts --commit
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# This unit fetches the supplier PDF itself.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The application directory stays read-only: nothing here writes to it.
ReadOnlyPaths=/var/www/html
# ProtectSystem=strict makes the whole filesystem read-only, and this unit now
# writes the snapshot itself instead of asking the app to do it over loopback —
# the change that removed the shared secret. Without this line every run died on
# EROFS after fetching and parsing the price list correctly. The installer fills
# the path from .env.production, the same place the application reads it from.
ReadWritePaths=__PRIVATE_BASIS_DIR__
