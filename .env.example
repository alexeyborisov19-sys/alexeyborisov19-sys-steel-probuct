NEXT_PUBLIC_SITE_URL=https://www.steelprodukt.ru

# E-mail delivery for quote requests. Use a provider approved in the processing
# services register and confirm that its primary databases are located in Russia.
# SMTP_USER and SMTP_PASSWORD must never be added to Git or sent in a chat.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@steelprodukt.ru
# Keep the SMTP envelope sender aligned with the visible From address and DKIM.
SMTP_ENVELOPE_FROM=info@steelprodukt.ru
QUOTE_RECIPIENT=info@steelprodukt.ru

# Private Russian storage. Keep every directory outside public/ and outside the
# deployment sync target. Directories use 0700 and stored files use 0600.
QUOTE_STORAGE_PATH=/var/lib/steelprodukt/quote-leads
ASSISTANT_LEAD_STORAGE_PATH=/var/lib/steelprodukt/assistant-leads
UPLOAD_QUARANTINE_PATH=/var/lib/steelprodukt/quarantine
CONSENT_AUDIT_STORAGE_PATH=/var/lib/steelprodukt/consent-audit
LEAD_RETENTION_DAYS=90
CONSENT_AUDIT_RETENTION_DAYS=1095
IP_HASH_SALT=
CONSENT_AUDIT_SALT=

# The current in-memory limiter and assistant sessions require one PM2 worker.
TRUST_NGINX_PROXY=true

# Optional fail-closed antivirus integration.
CLAMAV_ENABLED=false
CLAMAV_COMMAND=clamscan

# Search-console verification tokens are optional and remain server-managed.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# The approved Metrica counter is mandatory in production. The script is still
# loaded only after the visitor separately permits analytics cookies.
NEXT_PUBLIC_YM_COUNTER_ID=111263638
# Webvisor collects extended interaction data and is disabled by default.
NEXT_PUBLIC_YM_WEBVISOR=false

# Инженерный ИИ-помощник. Без этих параметров помощник продолжает работать
# по локальной проверенной базе знаний, но не использует генеративную модель.
# Ключ должен принадлежать сервисному аккаунту с минимально необходимой
# областью yc.ai.languageModels.execute и храниться только на сервере.
YANDEX_AI_ENABLED=false
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
YANDEX_AI_MODEL_URI=
YANDEX_AI_ENDPOINT=https://ai.api.cloud.yandex.net/foundationModels/v1/completion

# Telegram отключён в коде. Эти зарезервированные переменные не включают
# передачу сами по себе и оставлены только для явного будущего согласования.
ASSISTANT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=

# Закрытая система управления персональными данными. До отдельного ручного
# развёртывания и проверки на VPS она должна оставаться полностью выключенной.
PD_ADMIN_ENABLED=false
PD_ADMIN_DB_PATH=/var/lib/steelprodukt/admin/personal-data.sqlite
PD_SEARCH_HMAC_KEY=
PD_SEARCH_HMAC_KEY_VERSION=1
PD_SESSION_HASH_KEY=
PD_AUDIT_CHAIN_KEY=
PD_EXPORT_PATH=/var/lib/steelprodukt/exports
PD_EXPORT_TTL_HOURS=24
PD_SESSION_IDLE_MINUTES=30
PD_SESSION_ABSOLUTE_HOURS=8
PD_STEP_UP_MINUTES=10
PD_MAX_LOGIN_ATTEMPTS=5
PD_LOGIN_LOCK_MINUTES=15

# Резервное копирование на Этапе 2 только проектируется. Не указывайте
# иностранное хранилище без отдельного юридического решения. Ключ шифрования
# хранится в отдельном файле 0600 и не включается в Git или сам backup.
PD_BACKUP_PATH=
PD_BACKUP_ENCRYPTION_KEY_FILE=
